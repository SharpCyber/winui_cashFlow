<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CashFlow.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CashFlow.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource Nenhuma}">

    <Grid x:Name="gPrincipal">
        <FlyoutPresenter HorizontalAlignment="Stretch" 
                         VerticalAlignment="Center" 
                         Background="{StaticResource Cinza10}"
                         Margin="32" 
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Padding="32,18,32,38"
                         MaxHeight="600" 
                         MaxWidth="600">
            <Grid x:Name="gConteudo">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Cash Flow"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource Cinza2}"
                           Margin="0,0,0,32"
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"/>

                <Grid x:Name="gEmail" Grid.Row="1" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="bEmail" 
                            Grid.Row="0"
                            Height="44" 
                            BorderBrush="{StaticResource Vermelho5}" 
                            BorderThickness="1"
                            CornerRadius="4">

                        <Grid>
                            <TextBox x:Name="txtEmail"
                                     BorderThickness="0"
                                     Background="{StaticResource Vermelho5Transp10}"
                                     PlaceholderText="Digite seu e-mail"
                                     Padding="38,11,12,0"
                                     MaxLength="300"
                                     />

                            <FontIcon Glyph="&#xE715;"                
                                      FontSize="16"
                                      Foreground="{StaticResource Cinza2}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="txtEmailError"
                               Grid.Row="1" 
                               Text="Email inválido." 
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{StaticResource Vermelho1}"
                               Margin="4,4,0,0"/>
                </Grid>

                <Grid x:Name="gSenha" Grid.Row="2" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="bSenha" 
                            Grid.Row="0"
                            Height="44" 
                            BorderBrush="{StaticResource Vermelho5}" 
                            BorderThickness="1"
                            CornerRadius="4">

                        <Grid>
                            <PasswordBox x:Name="txtSenha"
                                         BorderThickness="0"
                                         Background="{StaticResource Vermelho5Transp10}"
                                         PlaceholderText="Digite sua senha"
                                         Padding="38,11,12,0"
                                         MaxLength="300"/>

                            <FontIcon Glyph="&#xE72E;"                
                                      FontSize="16"
                                      Foreground="{StaticResource Cinza2}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="txtSenhaError"
                               Grid.Row="1" 
                               Text="Senha inválido." 
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{StaticResource Vermelho1}"
                               Margin="4,4,0,0"/>
                </Grid>

                <Button x:Name="btnEntrar" Grid.Row="3"
                        Content="Entrar"
                        Click="btnEntrar_Click"
                        FontWeight="Bold"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"/>

                <Grid Grid.Row="4" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <HyperlinkButton x:Name="hlbEsqueciMinhaSenha" Click="hlbEsqueciMinhaSenha_Click" Content="Esqueci minha senha" Grid.Column="0" Foreground="{StaticResource Azul2}" HorizontalAlignment="Left"/>
                    <HyperlinkButton x:Name="hlbCadastrarUsuario" Click="hlbCadastrarUsuario_Click" Content="Cadastrar usuário" Grid.Column="1" Foreground="{StaticResource Azul2}" HorizontalAlignment="Right"/>
                </Grid>
                
                <Grid Grid.Row="5" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Height="2" 
                            Grid.Column="0"
                            MinWidth="200" 
                            Background="{StaticResource Cinza8}" 
                            HorizontalAlignment="Stretch"/>

                    <TextBlock Grid.Column="1" 
                               Text="OU" 
                               Foreground="{StaticResource Cinza7}" Margin="12,0"/>

                    <Border Height="2" 
                            Grid.Column="2"
                            MinWidth="200" 
                            Background="{StaticResource Cinza8}" 
                            HorizontalAlignment="Stretch"/>
                </Grid>

                <Button x:Name="btnLoginGoogle" Grid.Row="6"
                        Margin="0,18,0,0"
                        Click="btnLoginGoogle_Click"
                        Style="{StaticResource DefaultButtonStyle}"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image Source="ms-appx:///Assets/google_24x24.png" Margin="0" HorizontalAlignment="Stretch" Width="24" Height="24"/>
                        <TextBlock Text="Entrar com Google" 
                                   Foreground="{StaticResource Cinza1}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </FlyoutPresenter>
    </Grid>
</Page>
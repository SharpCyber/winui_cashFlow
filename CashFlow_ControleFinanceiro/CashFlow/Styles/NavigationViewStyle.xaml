<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="NavegacaoBase" TargetType="NavigationView">
        <Setter Property="Background" Value="{StaticResource Cinza12}"/>
        <Setter Property="PaneDisplayMode" Value="Left"/>
        <Setter Property="IsPaneToggleButtonVisible" Value="False"/>
        <Setter Property="IsSettingsVisible" Value="False"/>
        <Setter Property="IsBackButtonVisible" Value="Collapsed"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="ItemNavegacaoBase" TargetType="NavigationViewItem">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="4,0,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Height" Value="64"/>
    </Style>
    
</ResourceDictionary>
